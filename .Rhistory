knitr::opts_chunk$set(echo = TRUE, warning = FALSE, message = FALSE)
library(igraph)
nodes <- data.frame(
id    = c(1, 2, 3, 4, 5),
label = c("Alice", "Bob", "Carol", "David", "Eve"),
group = c("A", "A", "B", "C", "A"),
wealth = c(100, 200, 150, 300, 250)
)
edges_with_weight <- data.frame(
source = c(1, 1, 2, 2, 3, 4),
target = c(2, 5, 3, 4, 4, 5),
weight = c(3, 1, 2, 4, 2, 1)
)
g3 <- graph_from_data_frame(edges_with_weight, directed = FALSE, vertices = nodes)   # create a graph using the edge list and the node list
cat("Node labels:", ???, "\n")
g <- g3
g <- g3
deg <- degree(g, mode = "all", loops = FALSE)             # degree of every node
names(deg) <- V(g)$label
print(sort(deg, decreasing = TRUE))
btw <- betweenness(g, directed = FALSE, weights = NA)                  # betweenness centrality
btw_norm <- betweenness(g, directed = FALSE, weights = NA, normalized = TRUE)
# normalised betweenness centrality
print(sort(btw_norm, decreasing = TRUE))
clo <- closeness(g, mode = "all", weights = NA)                  # closeness centrality
clo_norm <- closeness(g, mode = "all", weights = NA, normalized = TRUE)             # normalised closeness centrality
print(sort(clo_norm, decreasing = TRUE))
eig <- eigen_centrality(g3, directed = FALSE, weights = NA)$vector                  # eigenvector centrality
print(sort(eig, decreasing = TRUE))
