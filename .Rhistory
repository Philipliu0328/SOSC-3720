cat("Node labels:", V(g3)$label, "\n")
cat("Edge weights:", E(g3)$weight, "\n")
group_colors <- c("A" = "lightblue", "B" = "salmon", "C" = "lightgreen")
plot(g3,
vertex.size   = V(g3)$wealth/3 ,   # wealth scaled for display
vertex.label  = V(g3)$label,
vertex.color  = group_colors[V(g3)$group],   # colour by group
edge.width    = E(g3)$weight,   # edge width by weight
vertex.label.cex = 0.9,
main = "Network with Node and Edge Attributes")
g <- g3
deg <- degree(g, mode = "all", loops = FALSE)                    # degree of every node
names(deg) <- V(g)$label
print(sort(deg, decreasing = TRUE))
btw <- betweenness(g, directed = FALSE, weights = NA)                  # betweenness centrality
btw_norm <- betweenness(g, directed = FALSE, weights = NA, normalized = TRUE)
# normalised betweenness centrality
print(sort(btw_norm, decreasing = TRUE))
clo <- closeness(g, mode = "all", weights = NA)                  # closeness centrality
clo_norm <- closeness(g, mode = "all", weights = NA, normalized = TRUE)             # normalised closeness centrality
print(sort(clo_norm, decreasing = TRUE))
eig <- eigen_centrality(g, directed = FALSE, weights = NA)$vector                  # eigenvector centrality
print(sort(eig, decreasing = TRUE))
flo_edges <- data.frame(
source = c("Acciaiuoli", "Albizzi", "Albizzi", "Albizzi", "Barbadori",
"Barbadori", "Bischeri", "Bischeri", "Bischeri", "Castellani",
"Castellani", "Ginori", "Guadagni", "Guadagni", "Guadagni",
"Lamberteschi", "Medici", "Medici", "Medici", "Pazzi",
"Peruzzi", "Ridolfi", "Ridolfi", "Salviati", "Strozzi"),
target = c("Medici", "Ginori", "Guadagni", "Medici", "Castellani",
"Medici", "Guadagni", "Peruzzi", "Strozzi", "Peruzzi",
"Strozzi", "Medici", "Lamberteschi", "Tornabuoni", "Bischeri",
"Guadagni", "Ridolfi", "Salviati", "Tornabuoni", "Salviati",
"Strozzi", "Strozzi", "Tornabuoni", "Tornabuoni", "Ridolfi")
)
g_flo <- graph_from_data_frame(flo_edges, directed = FALSE)
g_flo <- simplify(g_flo)
cat("Number of families:", vcount(g_flo), "\n")
cat("Number of marriage ties:", ecount(g_flo), "\n")
V(g_flo)$degree      <- degree(g_flo, mode = "all", loops = FALSE)
V(g_flo)$betweenness <- betweenness(g_flo, directed = FALSE, weights = NA)
V(g_flo)$closeness   <- closeness(
g_flo, mode = "all", weights = NA, normalized = TRUE
)   # normalised closeness
V(g_flo)$eigenvector <- eigen_centrality(
g_flo, directed = FALSE, weights = NA
)$vector
flo_results <- data.frame(
Family      = V(g_flo)$name,
Degree      = V(g_flo)$degree,
Betweenness = round(V(g_flo)$betweenness, 2),
Closeness   = round(V(g_flo)$closeness, 4),
Eigenvector = round(V(g_flo)$eigenvector, 4)
)
flo_results <- flo_results[order(-flo_results$Betweenness), ]
print(flo_results, row.names = FALSE)
medici_idx <- which(V(g_flo)$name == "Medici")
cat("Degree:", V(g_flo)$degree[medici_idx], "\n")
cat("Betweenness:", round(V(g_flo)$betweenness[medici_idx], 2), "\n")
cat("Closeness:", round(V(g_flo)$closeness[medici_idx], 4), "\n")
cat("Eigenvector:", round(V(g_flo)$eigenvector[medici_idx], 4), "\n")
cat("Degree rank:", rank(-V(g_flo)$degree)[medici_idx], "of", vcount(g_flo), "\n")
cat("Betweenness rank:", rank(-V(g_flo)$betweenness)[medici_idx], "of", vcount(g_flo), "\n")
cat("Closeness rank:", rank(-V(g_flo)$closeness)[medici_idx], "of", vcount(g_flo), "\n")
cat("Eigenvector rank:", rank(-V(g_flo)$eigenvector)[medici_idx], "of", vcount(g_flo), "\n")
btw_flo <- betweenness(g_flo)
btw_flo_scaled <- (btw_flo / max(btw_flo + 0.001)) * 20 + 10
V(g_flo)$color <- "lightblue"
V(g_flo)$color[medici_idx] <- "red"
set.seed(42)
plot(g_flo,
vertex.size = btw_flo_scaled,
vertex.label.cex = 0.6,
vertex.label.dist = 0.5,
layout = layout_with_fr(g_flo),
main = "Florentine Marriage Network\nSize = Betweenness, Red = Medici")
