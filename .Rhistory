knitr::opts_chunk$set(echo = TRUE, warning = FALSE, message = FALSE)
library(igraph)
install.packages("igraph")
library(igraph)
edges <- data.frame(
source = c(1, 1, 2, 2, 3),
target = c(2, 4, 3, 4, 4)
)
g1 <- graph_from_data_frame(edges, directed = FALSE)                                # create an undirected graph from edges
cat("Number of nodes:", vcount(g1), "\n")      # number of nodes
cat("Number of edges:", ecount(g1), "\n")      # number of edges
plot(g1, vertex.size = 30, vertex.color = "lightblue",
vertex.label.cex = 1.2, main = "Network from Edge List")
adj_matrix <- matrix(c(
0, 1, 0, 1,
1, 0, 1, 1,
0, 1, 0, 1,
1, 1, 1, 0
), nrow = 4, byrow = TRUE)
g2 <- graph_from_adjacency_matrix(adj_matrix, mode = "undirected")                       # create an undirected graph from the matrix
cat("Number of nodes:", vcount(g2), "\n")
cat("Number of edges:", ecount(g2) , "\n")
cat("Degrees:", degree(g2), "\n")      # degree of every node
plot(g2, vertex.size = 30, vertex.color = "salmon",
vertex.label.cex = 1.2, main = "Network from Adjacency Matrix")
nodes <- data.frame(
id    = c(1, 2, 3, 4, 5),
label = c("Alice", "Bob", "Carol", "David", "Eve"),
group = c("A", "A", "B", "C", "A"),
wealth = c(100, 200, 150, 300, 250)
)
edges_with_weight <- data.frame(
source = c(1, 1, 2, 2, 3, 4),
target = c(2, 5, 3, 4, 4, 5),
weight = c(3, 1, 2, 4, 2, 1)
)
g3 <- graph_from_data_frame(edges_with_weight, directed = FALSE, vertices = nodes)   # create a graph using the edge list and the node list
cat("Node labels:", vcount(g3)$label, "\n")
nodes <- data.frame(
id    = c(1, 2, 3, 4, 5),
label = c("Alice", "Bob", "Carol", "David", "Eve"),
group = c("A", "A", "B", "C", "A"),
wealth = c(100, 200, 150, 300, 250)
)
edges_with_weight <- data.frame(
source = c(1, 1, 2, 2, 3, 4),
target = c(2, 5, 3, 4, 4, 5),
weight = c(3, 1, 2, 4, 2, 1)
)
g3 <- graph_from_data_frame(edges_with_weight, directed = FALSE, vertices = nodes)   # create a graph using the edge list and the node list
cat("Node labels:", V(g3)$label, "\n")
cat("Edge weights:", E(g3)$weight, "\n")
group_colors <- c("A" = "lightblue", "B" = "salmon", "C" = "lightgreen")
plot(g3,
vertex.size   = V(g3)$wealth,   # wealth scaled for display
vertex.label  = V(g3)$label,
vertex.color  = group_colors[V(g3)$group],   # colour by group
edge.width    = E(g3)$weight,   # edge width by weight
vertex.label.cex = 0.9,
main = "Network with Node and Edge Attributes")
plot(g3,
vertex.size   = V(g3)$wealth/10 ,   # wealth scaled for display
vertex.label  = V(g3)$label,
vertex.color  = group_colors[V(g3)$group],   # colour by group
edge.width    = E(g3)$weight,   # edge width by weight
vertex.label.cex = 0.9,
main = "Network with Node and Edge Attributes")
plot(g3,
vertex.size   = V(g3)$wealth/5 ,   # wealth scaled for display
vertex.label  = V(g3)$label,
vertex.color  = group_colors[V(g3)$group],   # colour by group
edge.width    = E(g3)$weight,   # edge width by weight
vertex.label.cex = 0.9,
main = "Network with Node and Edge Attributes")
plot(g3,
vertex.size   = V(g3)$wealth/3 ,   # wealth scaled for display
vertex.label  = V(g3)$label,
vertex.color  = group_colors[V(g3)$group],   # colour by group
edge.width    = E(g3)$weight,   # edge width by weight
vertex.label.cex = 0.9,
main = "Network with Node and Edge Attributes")
g <- g3
cat("Number of nodes:",vcount(g), "\n")
cat("Number of edges:", ecount(g), "\n")
cat("Is connected:", is_connected(g), "\n")
cat("Density:", edge_density(g), "\n")
d_1_4 <- distances(g, v = "1", to = "4")[1, 1]                # distance from node "1" to node "4"
cat("Distance from Alice to David:", d_1_4, "\n")
sp <- shortest_paths(g, from = "1", to = "4", output = "vpath")
path_nodes <-  as.numeric(sp$vpath[[1]])             # numeric node IDs on the shortest path
path_labels <- V(g)$label[path_nodes]           # labels of those nodes
cat("Shortest path:", paste(path_labels, collapse = " -> "), "\n")
